local function unloadScript()
	-- Отключаем все потоки RenderStepped
	for _, conn in ipairs(connections) do
		conn:Disconnect()
	end
	-- Удаляем все ESP элементы
	for p, _ in pairs(espContainers) do
		removeEsp(p)
	end
	-- Удаляем FOV Circle
	if fovCircle then
		fovCircle:Remove()
	end
