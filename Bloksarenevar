local function getTeamColor(targetPlayer)
	if targetPlayer.Team then
		local name = targetPlayer.Team.Name:lower()
		if name:find("counter") or name:find("ct") or name:find("police") or name:find("spec") or name:find("defender") or name:find("blue") then
			return Color3.fromRGB(0, 150, 255) -- Синий
		elseif name:find("terrorist") or name:find("t") or name:find("attack") or name:find("red") then
			return Color3.fromRGB(255, 50, 50) -- Красный
		end
		return targetPlayer.TeamColor.Color
	end

	local isEnemy = true
	if Settings.ESPTeamCheck and player.Team and targetPlayer.Team then
		isEnemy = (player.Team ~= targetPlayer.Team)
	end
	return isEnemy and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(0, 150, 255)
end

local function removeEsp(targetPlayer)
	if espContainers[targetPlayer] then
		if espContainers[targetPlayer].Highlight then
			espContainers[targetPlayer].Highlight:Destroy()
		end
		if espContainers[targetPlayer].Billboard then
			espContainers[targetPlayer].Billboard:Destroy()
		end
		if espContainers[targetPlayer].Lines then
			for _, line in ipairs(espContainers[targetPlayer].Lines) do
				line:Destroy()
			end
		end
		espContainers[targetPlayer] = nil
	end
end

local function applyEsp(targetPlayer, character)
	if targetPlayer == player or not character then return end
	removeEsp(targetPlayer)

	local isEnemy = true
	if Settings.ESPTeamCheck and player.Team and targetPlayer.Team then
		isEnemy = (player.Team ~= targetPlayer.Team)
	end
	if Settings.ESPTeamCheck and not isEnemy then return end

	local color = getTeamColor(targetPlayer)
	local container = { Lines = {} }

	-- Chams
	if Settings.ESP_Chams then
		local highlight = Instance.new("Highlight")
		highlight.Name = "ESP_Chams"
		highlight.Adornee = character
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillColor = color
		highlight.FillTransparency = 0.75
		highlight.OutlineColor = color
		highlight.OutlineTransparency = 0.2
		highlight.Parent = character
		container.Highlight = highlight
	end

	-- Text ESP
	if Settings.ESP_Names or Settings.ESP_Distance or Settings.ESP_Health then
		local head = character:FindFirstChild("Head")
		if head then
			local billboard = Instance.new("BillboardGui")
			billboard.Name = "ESP_Info"
			billboard.Adornee = head
			billboard.Size = UDim2.new(0, 200, 0, 20)
			billboard.StudsOffset = Vector3.new(0, 2, 0)
			billboard.AlwaysOnTop = true
			billboard.Parent = head

			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(1, 0, 1, 0)
			label.BackgroundTransparency = 1
			label.Font = Enum.Font.Code
			label.TextSize = 11
			label.TextColor3 = color
			label.TextStrokeTransparency = 0.5
			label.TextStrokeColor3 = Color3.fromRGB(10, 10, 12)
			label.Parent = billboard

			container.Billboard = billboard
			container.Label = label
		end
	end

	-- Skeleton Lines
	if Settings.ESP_Skeleton then
		for _ = 1, #BONE_PAIRS do
			local line = Instance.new("Frame")
			line.AnchorPoint = Vector2.new(0.5, 0.5)
			line.BorderSizePixel = 0
			line.BackgroundColor3 = color
			line.Visible = false
			line.Parent = playerGui
			table.insert(container.Lines, line)
		end
	end

	espContainers[targetPlayer] = container
end

local function refreshESP()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			if p.Character then
				applyEsp(p, p.Character)
			else
				removeEsp(p)
			end
		end
	end
end

table.insert(connections, RunService.RenderStepped:Connect(function()
	for p, container in pairs(espContainers) do
		if p and p.Character then
			local char = p.Character
			local head = char:FindFirstChild("Head")
			local humanoid = char:FindFirstChild("Humanoid")

			if head and humanoid and humanoid.Health > 0 then
				local color = getTeamColor(p)

				if container.Label then
					local parts = {}
					if Settings.ESP_Names then table.insert(parts, p.Name) end
					if Settings.ESP_Health then table.insert(parts, math.floor((humanoid.Health / humanoid.MaxHealth) * 100) .. "%") end
					if Settings.ESP_Distance and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
						table.insert(parts, math.floor((head.Position - player.Character.HumanoidRootPart.Position).Magnitude) .. "m")
					end
					container.Label.TextColor3 = color
					container.Label.Text = table.concat(parts, " · ")
				end

				if Settings.ESP_Skeleton and container.Lines and #container.Lines > 0 then
					local lineIdx = 1
					for _, pair in ipairs(BONE_PAIRS) do
						local partA = char:FindFirstChild(pair[1])
						local partB = char:FindFirstChild(pair[2])
						local line = container.Lines[lineIdx]

						if partA and partB and line then
							local posA, visA = camera:WorldToViewportPoint(partA.Position)
							local posB, visB = camera:WorldToViewportPoint(partB.Position)

							if visA and visB then
								local pA = Vector2.new(posA.X, posA.Y)
								local pB = Vector2.new(posB.X, posB.Y)
								local dist = (pA - pB).Magnitude
								local center = (pA + pB) / 2
								local angle = math.deg(math.atan2(pB.Y - pA.Y, pB.X - pA.X))

								line.Size = UDim2.new(0, dist, 0, 1)
								line.Position = UDim2.new(0, center.X, 0, center.Y)
								line.Rotation = angle
								line.BackgroundColor3 = color
								line.Visible = true
							else
								line.Visible = false
							end
						elseif line then
							line.Visible = false
						end
						lineIdx = lineIdx + 1
					end
				end
			else
				removeEsp(p)
			end
		end
	end
end))

---------------------------------------------------------
-- AIMBOT LOGIC
---------------------------------------------------------

local function getClosestTarget(useScreenCenter)
	local closestPlayer = nil
	local shortestDistance = Settings.AimFOV
	local originPos = useScreenCenter and (camera.ViewportSize / 2) or UserInputService:GetMouseLocation()

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			local head = p.Character:FindFirstChild("Head")
			local humanoid = p.Character:FindFirstChild("Humanoid")

			if head and humanoid and humanoid.Health > 0 then
				if Settings.NoTeamAim and player.Team and p.Team and player.Team == p.Team then
					continue
				end

				local screenPos, onScreen = camera:WorldToViewportPoint(head.Position)

				if onScreen then
					local distance = (Vector2.new(screenPos.X, screenPos.Y) - originPos).Magnitude
					if distance < shortestDistance then
						shortestDistance = distance
						closestPlayer = p
					end
				end
			end
		end
	end
	return closestPlayer
end

table.insert(connections, RunService.RenderStepped:Connect(function(deltaTime)
	local screenCenter = camera.ViewportSize / 2
	
	-- Круг всегда рисуется ровно по центру экрана
	if fovCircle then
		fovCircle.Position = screenCenter
		fovCircle.Radius = Settings.AimFOV
		fovCircle.Visible = Settings.FOVAimbot
	end

	-- 1. Плавный Аимбот [ПКМ] (от курсора мыши)
	if Settings.SmoothAimbot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		local target = getClosestTarget(false)
		if target and target.Character and target.Character:FindFirstChild("Head") then
			local headPos = target.Character.Head.Position
			local currentCamCFrame = camera.CFrame
			local targetCFrame = CFrame.new(currentCamCFrame.Position, headPos)
			local alpha = math.clamp(Settings.Smoothness * deltaTime * 60, 0, 1)
			camera.CFrame = currentCamCFrame:Lerp(targetCFrame, alpha)
		end
	end

	-- 2. Быстрый Аимбот [Alt] (от курсора мыши)
	if Settings.FastAimbot and (UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt)) then
		local target = getClosestTarget(false)
		if target and target.Character and target.Character:FindFirstChild("Head") then
			camera.CFrame = CFrame.new(camera.CFrame.Position, target.Character.Head.Position)
		end
	end

	-- 3. FOV Аимбот [Shift] (от центра экрана)
	if Settings.FOVAimbot and (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)) then
		local target = getClosestTarget(true)
		if target and target.Character and target.Character:FindFirstChild("Head") then
			camera.CFrame = CFrame.new(camera.CFrame.Position, target.Character.Head.Position)
		end
	end
end))

