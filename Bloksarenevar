	btn.BackgroundColor3 = defaultState and ACCENT or BORDER_COLOR
	btn.Text = ""
	btn.Parent = frame

	Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

	local state = defaultState or false
